# Production API Endpoint
# If deploying Frontend separately (e.g. Vercel / Netlify):
# VITE_API_BASE_URL=https://your-backend-api.onrender.com/api
#
# If deploying Full-Stack together (e.g. Render / Railway / Docker / VPS):
# Leave empty or set to /api so requests are made relative to same origin:
VITE_API_BASE_URL=/api
